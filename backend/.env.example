PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/epts
JWT_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_RESET_SECRET=your_jwt_password_reset_secret
NODE_ENV=development

# SMTP config for sending Forgot Password OTP emails.
# If left unset, OTPs are logged to the server console instead of emailed (dev fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
